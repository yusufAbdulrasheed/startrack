# Copy to .env and fill in. For local dev you can leave MONGODB_URI blank —
# the server will spin up an in-process MongoDB automatically.

PORT=4000
# Leave blank for dev (in-memory Mongo). For real persistence, paste your
# MongoDB Atlas connection string here.
MONGODB_URI=
# Change this to a long random string before any real deployment.
JWT_SECRET=dev-secret-change-me
# Where the web app runs (for CORS).
WEB_ORIGIN=http://localhost:5173
