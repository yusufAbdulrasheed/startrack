# Copy to .env and fill in.
# Local dev: `npm run dev` at the repo root starts the dev MongoDB on this
# fixed port (data persists in server/.data/mongo), plus the API and web app.
# For cloud persistence, replace MONGODB_URI with your Atlas connection string.
# Leave MONGODB_URI blank to run a throwaway in-memory DB (data lost on stop).

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27818/startrack
# Change this to a long random string before any real deployment.
JWT_SECRET=dev-secret-change-me
# Where the web app runs (for CORS).
WEB_ORIGIN=http://localhost:5173
