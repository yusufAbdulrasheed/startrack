# Copy to .env and fill in.
# Local dev: `npm run dev` starts the dev MongoDB on this fixed port
# (data persists in .data/mongo), plus the API and the web client.
# For cloud persistence, replace MONGODB_URI with your Atlas connection string.
# Leave MONGODB_URI blank to run a throwaway in-memory DB (data lost on stop).

PORT=4000
# The dev web server. Change it if something else already owns 5173.
WEB_PORT=5173
MONGODB_URI=mongodb://127.0.0.1:27818/startrack?replicaSet=rs0
# Change this to a long random string before any real deployment.
JWT_SECRET=dev-secret-change-me

# ── Alert email (optional) ──────────────────────────────────────────
# Leave blank and alerts still work — they appear in the app's bell.
# Fill these in to also send the digest by email.
# Gmail: use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StarTrack Alerts <alerts@yourshop.com>"
# How often to look for expiring stock and unattended returns. 0 disables it.
ALERT_SWEEP_HOURS=6

# ── StarTrack platform staff (optional) ─────────────────────────────
# The account promoted to overseer on boot: it can see every tenant on the
# platform. Leave blank and nobody has platform access.
PLATFORM_OWNER_EMAIL=
