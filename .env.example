# Copy to .env and fill in.
# Local dev: `npm run dev` starts the dev MongoDB on this fixed port
# (data persists in .data/mongo), plus the API and the web client.
# For cloud persistence, replace MONGODB_URI with your Atlas connection string.
# Leave MONGODB_URI blank to run a throwaway in-memory DB (data lost on stop).

PORT=4000
# The dev web server. Change it if something else already owns 5173.
WEB_PORT=5173
MONGODB_URI=mongodb://127.0.0.1:27818/startrack?replicaSet=rs0
# Change this to a long random string before any real deployment.
JWT_SECRET=dev-secret-change-me

# ── Email, via Resend (optional) ─────────────────────────────────────
# Leave blank and everything still works — alerts appear in the app's bell,
# every email send is just skipped. Every kind of email this app sends
# (alerts today, whatever comes next) goes through this one account.
# Get a key at resend.com/api-keys.
RESEND_API_KEY=
# Needs a domain verified in Resend to send from your own address; until
# then this can stay as Resend's shared testing sender (only deliverable to
# your own Resend account email).
MAIL_FROM="StarTrack Alerts <onboarding@resend.dev>"
# How often to look for expiring stock and unattended returns. 0 disables it.
ALERT_SWEEP_HOURS=6

# ── StarTrack platform staff (optional) ─────────────────────────────
# The account promoted to overseer on boot: it can see every tenant on the
# platform. Leave blank and nobody has platform access.
PLATFORM_OWNER_EMAIL=

# ── Product photos, via Cloudinary (optional) ───────────────────────
# Leave blank and everything still works — products just show a category
# icon instead of a photo. Get free credentials at cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Keep-awake ping (optional) ───────────────────────────────────────
# Render's free tier sleeps a web service after 15 minutes idle, which turns
# the next visit into a slow cold start. On Render itself this needs nothing
# — RENDER_EXTERNAL_URL is set automatically. PING_URL overrides it for any
# other host doing the same thing. Leave both blank (always the case in
# local dev) and the ping never runs.
PING_URL=
