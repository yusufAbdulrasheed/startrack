{
  "name": "startrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StarTrack — multi-tenant business operations platform. One app: the API serves the built web client.",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#core/*": "./server/core/*",
    "#platform/*": "./server/platform/*",
    "#businesses/*": "./server/businesses/*",
    "#modules/*": "./server/modules/*",
    "#shared/*": "./server/shared/*"
  },
  "scripts": {
    "dev": "concurrently -k -n db,api,web -c yellow,green,cyan \"npm:dev:db\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:db": "node server/scripts/dev-db.js",
    "dev:api": "node --watch-path=./server server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "check:architecture": "node server/scripts/checkArchitecture.js",
    "seed:showcase": "node server/scripts/seedShowcase.js",
    "seed:showcase:reset": "node server/scripts/seedShowcase.js --reset",
    "seed:empty": "node server/scripts/seedEmptyTest.js",
    "seed:plans": "node server/scripts/assignPlans.js",
    "seed:admin": "node server/scripts/seedSuperAdmin.js",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "es-toolkit": "^1.51.0",
    "exceljs": "^3.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.24.0",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "serverless-http": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "mongodb-memory-server": "^10.1.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
